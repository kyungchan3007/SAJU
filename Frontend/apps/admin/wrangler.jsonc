{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "saju-admin",
  "account_id": "a83a4cf51f88f7b33e2e8a258f081900",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "admin.saju-me.com",
      "custom_domain": true
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://admin.saju-me.com",
    "NEXT_PUBLIC_APP_NAME": "SAJU:ME-Admin"
  }
}
